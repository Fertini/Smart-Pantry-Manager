<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="10dp"
    android:orientation="vertical"
    tools:context=".fragments.pantryItemFragments.PantryListFragment">

    <!-- heading -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="35dp"
        android:layout_marginVertical="10dp"
        app:cardCornerRadius="50dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/blush_pop"
            android:text="@string/pantry_label"
            android:fontFamily="@font/bagel_fat"
            android:textColor="@color/mint_cream"
            android:textSize="35sp"
            android:textStyle="bold"
            android:gravity="center"/>

    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pantry_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        />
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/suggested_recipes_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:actionLayout="@layout/suggested_recipes_fragment"
            android:paddingLeft="10dp"
            android:layout_alignParentRight="true"
            android:text="@string/suggested_btn"
            android:textSize="18sp"
            android:fontFamily="@font/bagel_fat"
            android:textColor="@color/lemon_chiffon"
            app:icon="@drawable/ic_suggested_recipes"
            app:iconSize="35dp"
            app:iconTint="@color/lemon_chiffon"
            app:backgroundTint="@color/bright_orange"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_pantry_item_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:actionLayout="@layout/add_pantry_item_layout"
            android:paddingLeft="10dp"
            android:layout_alignParentLeft="true"
            android:text="@string/add_btn"
            android:textSize="18sp"
            android:fontFamily="@font/bagel_fat"
            android:textColor="@color/lemon_chiffon"
            app:icon="@drawable/ic_suggested_recipes"
            app:iconSize="35dp"
            app:iconTint="@color/lemon_chiffon"
            app:backgroundTint="@color/grapefruit_pink"
            />
    </RelativeLayout>


</LinearLayout>