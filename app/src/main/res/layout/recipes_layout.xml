<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="10dp"
    android:orientation="vertical"
    tools:context=".fragments.recipeFragments.RecipeListFragment">

    <!-- recipes heading -->
    <androidx.cardview.widget.CardView
        android:id="@+id/heading_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="35dp"
        android:layout_marginVertical="10dp"
        app:cardCornerRadius="50dp">
        <TextView
            android:id="@+id/heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/blush_pop"
            android:text="@string/recipes_label"
            android:fontFamily="@font/bagel_fat"
            android:textColor="@color/mint_cream"
            android:textSize="35sp"
            android:textStyle="bold"
            android:gravity="center"/>

    </androidx.cardview.widget.CardView>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- text for no recipes -->
        <TextView
            android:id="@+id/no_recipes_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textColor="@color/dusty_grey"
            android:text=""
            android:textSize="35sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <!-- recipe list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recipe_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical" />

        <!-- add btn -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_recipe_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:backgroundTint="@color/sky_blue"
            android:text="@string/add_btn"
            android:textSize="18sp"
            android:textColor="@color/mint_cream"
            android:fontFamily="@font/bagel_fat"
            android:elevation="5dp"
            app:icon="@drawable/ic_suggested_recipes"
            app:iconSize="35dp"
            app:iconTint="@color/mint_cream"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            />

    </RelativeLayout>

</LinearLayout>