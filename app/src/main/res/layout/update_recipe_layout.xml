<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.recipeFragments.EditRecipeFragment">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_margin="10dp"
    tools:context=".fragments.recipeFragments.EditRecipeFragment">

    <!-- recipe name -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recipe_name_label"
        android:textSize="30sp"
        android:textColor="@color/grapefruit_pink"
        android:fontFamily="@font/bagel_fat"
        android:paddingHorizontal="40dp"
        />

    <EditText
        android:id="@+id/recipe_name"
        android:inputType="text"
        android:hint="@string/recipe_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColorHint="@color/dusty_grey"
        android:textSize="20sp"
        android:paddingHorizontal="20dp"
        />

    <!-- recipe description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recipe_description_label"
        android:textSize="30sp"
        android:textColor="@color/grapefruit_pink"
        android:fontFamily="@font/bagel_fat"
        android:paddingHorizontal="40dp"
        />

    <EditText
        android:id="@+id/recipe_description"
        android:inputType="text"
        android:hint="@string/recipe_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColorHint="@color/dusty_grey"
        android:textSize="20sp"
        android:paddingHorizontal="20dp"
        />

    <!-- recipe ingredients -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recipe_ingredients_label"
        android:textSize="30sp"
        android:textColor="@color/grapefruit_pink"
        android:fontFamily="@font/bagel_fat"
        android:paddingHorizontal="40dp"
        />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/light_gold"
        app:cardCornerRadius="7dp"
        app:cardBackgroundColor="@color/lemon_chiffon">
        <TextView
            android:id="@+id/recipe_ingredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recipe_ingredients"
            android:textColor="@color/ink_black"
            android:textSize="20sp"
            android:padding="10dp"
            />
    </com.google.android.material.card.MaterialCardView>

    <!-- recipe instructions -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recipe_instructions_label"
        android:textSize="30sp"
        android:textColor="@color/grapefruit_pink"
        android:fontFamily="@font/bagel_fat"
        android:paddingHorizontal="40dp"
        />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/light_gold"
        app:cardBackgroundColor="@color/lemon_chiffon"
        app:cardCornerRadius="7dp"
        >
        <TextView
            android:id="@+id/recipe_instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recipe_instructions"
            android:textColor="@color/ink_black"
            android:textSize="20sp"
            android:padding="10dp"
            android:background="@color/lemon_chiffon"
            />
    </com.google.android.material.card.MaterialCardView>

    <!-- recipe duration -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/duration_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recipe_duration_label"
            android:textSize="30sp"
            android:textColor="@color/grapefruit_pink"
            android:fontFamily="@font/bagel_fat"
            android:paddingHorizontal="40dp"
            />

        <TextView
            android:id="@+id/recipe_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recipe_duration"
            android:textColor="@color/ink_black"
            android:textSize="18sp"
            android:layout_marginBottom="7.5dp"
            android:layout_alignParentRight="true"
            android:layout_alignBottom="@id/duration_label"
            android:paddingHorizontal="20dp"
            />

    </RelativeLayout>

    <!-- recipe serving size -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <TextView
            android:id="@+id/serving_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recipe_serving_label"
            android:textSize="30sp"
            android:textColor="@color/grapefruit_pink"
            android:fontFamily="@font/bagel_fat"
            android:paddingHorizontal="40dp"
            />

        <TextView
            android:id="@+id/recipe_serving"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recipe_serving"
            android:textColor="@color/ink_black"
            android:textSize="18sp"
            android:layout_marginBottom="7.5dp"
            android:layout_alignParentRight="true"
            android:layout_alignBottom="@id/serving_label"
            android:paddingHorizontal="20dp"
            />
    </RelativeLayout>

    <!-- recipe calories -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <TextView
            android:id="@+id/calories_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recipe_calories_label"
            android:textSize="30sp"
            android:textColor="@color/grapefruit_pink"
            android:fontFamily="@font/bagel_fat"
            android:paddingHorizontal="40dp"
            />

        <TextView
            android:id="@+id/recipe_calories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recipe_calories"
            android:textColor="@color/ink_black"
            android:textSize="18sp"
            android:layout_marginBottom="7.5dp"
            android:layout_alignParentRight="true"
            android:layout_alignBottom="@id/calories_label"
            android:paddingHorizontal="20dp"
            />
    </RelativeLayout>

    <!-- save button -->
    <Button
        android:id="@+id/edit_recipe_item_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="70dp"
        android:layout_gravity="bottom|center"
        android:layout_marginVertical="20dp"
        android:backgroundTint="@color/blush_pop"
        android:fontFamily="@font/bagel_fat"
        android:padding="15dp"
        android:text="@string/save"
        android:textSize="20sp"
        android:textColor="@color/mint_cream"/>

</LinearLayout>
</ScrollView>