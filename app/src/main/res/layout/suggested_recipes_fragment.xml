<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="10dp"
    android:orientation="vertical"
    tools:context=".fragments.recipeFragments.RecipeListFragment">

    <!-- recipes heading -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="35dp"
        android:layout_marginVertical="10dp"
        app:cardCornerRadius="50dp">
        <TextView
            android:id="@+id/heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/blush_pop"
            android:text="@string/suggested_recipes_label"
            android:fontFamily="@font/bagel_fat"
            android:textColor="@color/mint_cream"
            android:textSize="35sp"
            android:textStyle="bold"
            android:gravity="center"/>

    </androidx.cardview.widget.CardView>

    <!-- recipe list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recipe_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        />


</LinearLayout>