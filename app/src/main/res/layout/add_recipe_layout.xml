<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".fragments.recipeFragments.AddRecipeFragment" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="10dp" >

        <!-- recipe name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recipe_name_label"
            android:textSize="30sp"
            android:textColor="@color/grapefruit_pink"
            android:fontFamily="@font/bagel_fat"
            android:paddingHorizontal="40dp" />

        <EditText
            android:id="@+id/recipe_name"
            android:inputType="text"
            android:hint="@string/recipe_name"
            android:textColorHint="@color/dusty_grey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_black"
            android:textSize="20sp"
            android:paddingHorizontal="20dp" />

        <!-- recipe description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recipe_description_label"
            android:textSize="30sp"
            android:textColor="@color/grapefruit_pink"
            android:fontFamily="@font/bagel_fat"
            android:paddingHorizontal="40dp" />

        <EditText
            android:id="@+id/recipe_description"
            android:inputType="text"
            android:hint="@string/recipe_description"
            android:textColorHint="@color/dusty_grey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_black"
            android:textSize="20sp"
            android:paddingHorizontal="20dp" />

        <!-- recipe ingredients -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recipe_ingredients_label"
            android:textSize="30sp"
            android:textColor="@color/grapefruit_pink"
            android:fontFamily="@font/bagel_fat"
            android:paddingHorizontal="40dp" />

        <!-- ingredients container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            app:strokeWidth="2dp"
            app:cardBackgroundColor="@color/lemon_chiffon"
            app:strokeColor="@color/light_gold"
            app:cardCornerRadius="7dp" >

            <TextView
                android:id="@+id/recipe_ingredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text=""
                android:textColor="@color/ink_black"
                android:textSize="20sp" />
        </com.google.android.material.card.MaterialCardView>

            <!-- ingredient box-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_gravity="left|center"
                    app:cardCornerRadius="5dp"
                    app:strokeColor="@color/bright_orange"
                    app:strokeWidth="2dp"
                    app:cardElevation="5dp"
                    app:cardBackgroundColor="@color/cornsilk" >

                    <!-- item -->
                    <EditText
                        android:id="@+id/ingredient_description"
                        android:inputType="text"
                        android:textColorHint="@color/dusty_grey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="20dp"
                        android:hint="ingredient"
                        android:textColor="@color/ink_black"
                        android:textSize="20sp" />

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/add_ingredient_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right"
                    android:layout_marginLeft="10dp"
                    android:text="@string/add_btn"
                    android:textSize="18sp"
                    android:textColor="@color/mint_cream"
                    android:fontFamily="@font/bagel_fat"
                    android:backgroundTint="@color/grapefruit_pink" />
            </LinearLayout>

        <!-- recipe instructions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recipe_instructions_label"
            android:textSize="30sp"
            android:textColor="@color/grapefruit_pink"
            android:fontFamily="@font/bagel_fat"
            android:paddingHorizontal="40dp" />

        <!-- instructions container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/light_gold"
            app:cardBackgroundColor="@color/lemon_chiffon"
            app:cardCornerRadius="7dp" >

            <TextView
                android:id="@+id/recipe_instructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text=""
                android:textColor="@color/ink_black"
                android:textSize="20sp" />
        </com.google.android.material.card.MaterialCardView>

            -<!-- instruction box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" >

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_gravity="left|center"
                    app:cardCornerRadius="5dp"
                    app:strokeColor="@color/bright_orange"
                    app:strokeWidth="2dp"
                    app:cardElevation="5dp"
                    app:cardBackgroundColor="@color/cornsilk" >

                    <!-- item -->
                    <EditText
                        android:id="@+id/instruction_description"
                        android:inputType="text"
                        android:layout_width="match_parent"
                        android:textColorHint="@color/dusty_grey"
                        android:layout_height="wrap_content"
                        android:paddingLeft="20dp"
                        android:hint="instruction"
                        android:textColor="@color/ink_black"
                        android:textSize="20sp" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/add_instruction_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right"
                    android:layout_marginLeft="10dp"
                    android:text="@string/add_btn"
                    android:textSize="18sp"
                    android:textColor="@color/mint_cream"
                    android:fontFamily="@font/bagel_fat"
                    android:backgroundTint="@color/grapefruit_pink" />
            </LinearLayout>

        <!-- recipe duration -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recipe_duration_label"
            android:textSize="30sp"
            android:textColor="@color/grapefruit_pink"
            android:fontFamily="@font/bagel_fat"
            android:paddingHorizontal="40dp" />

        <EditText
            android:id="@+id/recipe_duration"
            android:inputType="number"
            android:hint="@string/recipe_duration"
            android:textColorHint="@color/dusty_grey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_black"
            android:textSize="20sp"
            android:paddingHorizontal="20dp" />

        <!-- recipe serving size -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recipe_serving_label"
            android:textSize="30sp"
            android:textColor="@color/grapefruit_pink"
            android:fontFamily="@font/bagel_fat"
            android:paddingHorizontal="40dp" />

        <EditText
            android:id="@+id/recipe_serving"
            android:inputType="number"
            android:hint="@string/recipe_serving"
            android:textColorHint="@color/dusty_grey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_black"
            android:textSize="20sp"
            android:paddingHorizontal="20dp" />

        <!-- recipe calories -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recipe_calories_label"
            android:textSize="30sp"
            android:textColor="@color/grapefruit_pink"
            android:fontFamily="@font/bagel_fat"
            android:paddingHorizontal="40dp" />

        <EditText
            android:id="@+id/recipe_calories"
            android:inputType="number"
            android:hint="@string/recipe_calories"
            android:textColorHint="@color/dusty_grey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_black"
            android:textSize="20sp"
            android:paddingHorizontal="20dp" />

        <!-- save button -->
        <Button
            android:id="@+id/add_recipe_item_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="70dp"
            android:layout_gravity="bottom|center"
            android:layout_marginVertical="20dp"
            android:backgroundTint="@color/blush_pop"
            android:fontFamily="@font/bagel_fat"
            android:padding="10dp"
            android:text="@string/add_btn"
            android:textSize="20sp"
            android:textColor="@color/mint_cream"
            android:actionLayout="@layout/recipes_layout" />

    </LinearLayout>
</ScrollView>