<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="15dp"
    app:cardElevation="5dp"
    app:cardBackgroundColor="@color/pink_orchid">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/pantry_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:text="@string/pantry_item_name"
            android:textColor="@color/cornsilk"
            android:textSize="22sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/pantry_item_quantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:text="@string/pantry_item_quantity"
                android:textColor="@color/mint_cream"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/pantry_item_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pantry_item_unit"
                android:textColor="@color/mint_cream"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_toRightOf="@id/pantry_item_quantity"
                />
        </RelativeLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>