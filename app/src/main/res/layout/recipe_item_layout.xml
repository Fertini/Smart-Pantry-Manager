<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cornsilk"
    tools:context=".RecipeListFragment">

    <!-- Header -->
    <TextView
        android:id="@+id/main_heading"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:fontFamily="@font/modak_regular"
        android:text="@string/app_name"
        android:gravity="center"
        android:textColor="@color/light_gold"
        android:background="@color/sky_blue"
        android:textSize="50sp" />

    <!-- recipe name -->
    <include layout="@layout/recipe_heading"/>

    <androidx.cardview.widget.CardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/items_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mint_cream"
        android:padding="10dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="20dp"
        android:elevation="10dp">

    </androidx.cardview.widget.CardView>




</LinearLayout>