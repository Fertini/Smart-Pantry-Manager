<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_margin="10dp"
    tools:context=".fragments.recipeFragments.RecipeListFragment">

    <!-- recipe name -->
    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:orientation="vertical"
        app:cardCornerRadius="25dp"
        app:cardElevation="5dp">

        <TextView
            android:id="@+id/recipe_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/recipe_name"
            android:textSize="28sp"
            android:background="@color/bright_orange"
            android:textStyle="italic|normal"
            android:fontFamily="@font/bagel_fat"
            android:textColor="@color/mint_cream"
            android:paddingVertical="5dp"
            />

    </androidx.cardview.widget.CardView>

    <!-- recipe description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recipe_description_label"
        android:textSize="30sp"
        android:textColor="@color/grapefruit_pink"
        android:fontFamily="@font/bagel_fat"
        android:paddingHorizontal="40dp"
       />

    <TextView
        android:id="@+id/recipe_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recipe_description"
        android:textColor="@color/ink_black"
        android:textSize="18sp"
        android:paddingHorizontal="20dp"
        />

    <!-- recipe ingredients -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recipe_ingredients_label"
        android:textSize="30sp"
        android:textColor="@color/grapefruit_pink"
        android:fontFamily="@font/bagel_fat"
        android:paddingHorizontal="40dp"
        />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/recipe_ingredients"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recipe_ingredients"
        android:textColor="@color/ink_black"
        android:textSize="18sp"
        android:paddingHorizontal="20dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/light_gold"
        />

    <!-- recipe instructions -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recipe_instructions_label"
        android:textSize="30sp"
        android:textColor="@color/grapefruit_pink"
        android:fontFamily="@font/bagel_fat"
        android:paddingHorizontal="40dp"
        />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/recipe_instructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recipe_instructions"
        android:textColor="@color/ink_black"
        android:textSize="18sp"
        android:paddingHorizontal="20dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/light_gold"
        app:background="@color/lemon_chiffon"
        app:cornerRadius="15dp"
        />

    <!-- recipe duration -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/duration_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recipe_duration_label"
            android:textSize="30sp"
            android:textColor="@color/grapefruit_pink"
            android:fontFamily="@font/bagel_fat"
            android:paddingHorizontal="40dp"
            />

        <TextView
            android:id="@+id/recipe_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recipe_duration"
            android:textColor="@color/ink_black"
            android:textSize="18sp"
            android:layout_marginBottom="7.5dp"
            android:layout_alignParentRight="true"
            android:layout_alignBottom="@id/duration_label"
            android:paddingHorizontal="20dp"
            />

    </RelativeLayout>

    <!-- recipe serving size -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <TextView
            android:id="@+id/serving_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recipe_serving_label"
            android:textSize="30sp"
            android:textColor="@color/grapefruit_pink"
            android:fontFamily="@font/bagel_fat"
            android:paddingHorizontal="40dp"
            />

        <TextView
            android:id="@+id/recipe_serving"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recipe_serving"
            android:textColor="@color/ink_black"
            android:textSize="18sp"
            android:layout_marginBottom="7.5dp"
            android:layout_alignParentRight="true"
            android:layout_alignBottom="@id/serving_label"
            android:paddingHorizontal="20dp"
            />
    </RelativeLayout>

    <!-- recipe calories -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <TextView
            android:id="@+id/calories_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recipe_calories_label"
            android:textSize="30sp"
            android:textColor="@color/grapefruit_pink"
            android:fontFamily="@font/bagel_fat"
            android:paddingHorizontal="40dp"
            />

        <TextView
            android:id="@+id/recipe_calories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recipe_calories"
            android:textColor="@color/ink_black"
            android:textSize="18sp"
            android:layout_marginBottom="7.5dp"
            android:layout_alignParentRight="true"
            android:layout_alignBottom="@id/calories_label"
            android:paddingHorizontal="20dp"
            />
    </RelativeLayout>

    <!-- edit button -->
    <Button
        android:id="@+id/edit_recipe_item_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="70dp"
        android:layout_gravity="bottom|center"
        android:layout_marginVertical="20dp"
        android:backgroundTint="@color/blush_pop"
        android:fontFamily="@font/bagel_fat"
        android:padding="15dp"
        android:text="@string/edit_recipe_item"
        android:textSize="18sp"
        android:actionLayout="@layout/update_recipe_layout"/>

</LinearLayout>